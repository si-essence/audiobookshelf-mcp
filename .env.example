# Copy to .env (git-ignored) or set these in your MCP client config.

# Audiobookshelf origin. No userinfo, query, or hash.
ABS_BASE_URL=http://127.0.0.1:13378

# API token (Settings > Users > your user, or Settings > API Keys). Sent as "Authorization: Bearer <token>". Never printed.
ABS_API_TOKEN=

# The literal "true" enables writes. Anything else keeps the connector read-only.
ABS_ALLOW_WRITES=false

# Optional comma-separated toolsets; admin/user toolsets are off by default.
# ABS_TOOLSETS=
